[Unit]
Description=kindle-monitor: run requested commands (root, fixed action table)

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/kindle-monitor/deploy/kindle-monitor-executor.py --config /etc/kindle-monitor/config.json
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
TimeoutStartSec=180
