[Unit]
Description=kindle-monitor: run requested commands (root, fixed action table)
# The path unit re-triggers this on every new request; do not let systemd rate-limit it into failure.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/kindle-monitor/deploy/kindle-monitor-executor.py --config /etc/kindle-monitor/config.json
NoNewPrivileges=yes
# incus reads its client config under /root/.config: read-only keeps /root unwritable but readable
ProtectHome=read-only
PrivateTmp=yes
TimeoutStartSec=180
# Hardening. VALIDATE ON THE HOST (see server/README.md): systemctl needs D-Bus, incus its unix socket.
ProtectSystem=strict
ReadWritePaths=/run/kindle-monitor
ReadWritePaths=-/var/lib/incus/unix.socket
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX is required (D-Bus, incus socket); do not remove it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
