[Unit]
Description=kindle-monitor: inventory of service states (root, read-only commands)
# Triggered by the timer every 15 s; a slow run must not be rate-limited into failure.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# runs every ~15 s: keep the journal quiet (errors and warnings still show)
LogLevelMax=warning
User=root
ExecStart=/usr/bin/python3 -I /opt/kindle-monitor/deploy/kindle-monitor-executor.py --inventario --config /etc/kindle-monitor/config.json
NoNewPrivileges=yes
# incus reads its client config under /root/.config: read-only keeps /root unwritable but readable
ProtectHome=read-only
PrivateTmp=yes
# worst case: 4 batched service calls + tailscale status + 2 routine calls, 10 s timeout each (70 s), plus margin
TimeoutStartSec=120
# Same hardening as the executor. VALIDATE ON THE HOST (see server/README.md): systemctl needs D-Bus, incus its unix socket.
ProtectSystem=strict
# the inventory only writes status/*.json (created by tmpfiles.d before any unit starts); the spool and the parent
# are opened read-only. tailscaled's socket needs no entry: connect() works on a read-only mount.
ReadWritePaths=/run/kindle-monitor/status
ReadWritePaths=-/var/lib/incus/unix.socket
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX is required (D-Bus, incus socket); do not remove it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
