[Unit]
Description=kindle-monitor: watch the command spool

[Path]
# Only a name ending in .req triggers the executor. A stray .tmp does not match; a directory named *.req would,
# so the executor renames such directories to .lixo-<epoch>-<n> (outside the glob) instead of leaving them.
PathExistsGlob=/run/kindle-monitor/spool/*.req
Unit=kindle-monitor-executor.service

[Install]
WantedBy=multi-user.target
